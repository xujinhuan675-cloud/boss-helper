{
  "extends": "./.wxt/tsconfig.json",
  "compilerOptions": {
    "jsx": "preserve",
    "jsxImportSource": "vue",
    "allowArbitraryExtensions": true,
    "verbatimModuleSyntax": true,
    "types": ["bun-types/test", "chrome", "node", "react", "react-dom", "spark-md5"],
    "paths": {
      "@": ["./src"],
      "@/*": ["./src/*"],
      "~": ["./src"],
      "~/*": ["./src/*"],
      "@@": ["."],
      "@@/*": ["./*"],
      "~~": ["."],
      "~~/*": ["./*"],
      "#build/ui": ["./node_modules/.nuxt-ui/ui"],
      "#build/ui/*": ["./node_modules/.nuxt-ui/ui/*"],
      "devlog-ui": ["./packages/devlog-ui/src"]
    }
  }
}
